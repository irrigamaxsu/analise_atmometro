#################### Diferenças diárias de ETo-PM & ETo-AMM ####################
################################################################################

edt_amm1=eto_pm-eto_amm1; edt_amm1
edt_amm2=eto_pm-eto_amm2; edt_amm2
edt_amm3=eto_pm-eto_amm3; edt_amm3
edt_amm4=eto_pm-eto_amm4; edt_amm4
edt_amm5=eto_pm-eto_amm5; edt_amm5
edt_amm6=eto_pm-eto_amm6; edt_amm6

relative_error=c(edt_amm1,edt_amm2,edt_amm3,edt_amm4,edt_amm5,edt_amm6)

relative_error=data.frame(error=c(edt_amm1,edt_amm2,edt_amm3,edt_amm4,edt_amm5,edt_amm6),
                          amm=c(rep("AMM1",42), rep("AMM2",42), rep("AMM3",42), rep("AMM4",42), rep("AMM5",42), rep("AMM6",42)))

amm=relative_error$amm; amm=factor(amm)


library(ggplot2)

# Criando um índice para representar a ordem das observações
relative_error$Ordem <- rep(1:42, times = 6)

# Criando o gráfico
ggplot(relative_error, aes(x = Ordem, y = error, shape = amm, color = amm)) +
  geom_point(size = 4) +  # Adiciona pontos com diferentes formas para cada AMM
  geom_line(aes(group = amm), linewidth = 0.8, alpha = 0.6) +  # Adiciona linhas conectando os pontos de cada AMM
  scale_x_continuous(breaks = seq(1, 42, by = 2)) +  # Define os rótulos no eixo X
  scale_shape_manual(values = c(0, 5, 2, 16, 19, 17)) +  # Define diferentes símbolos para cada AMM
  xlab("Ordem das Observações") +
  ylab("Erro Relativo (mm/dia)") +
  theme_classic() +  # Remove fundo e mantém apenas os eixos visíveis
  theme(
    axis.line = element_line(color = "black", linewidth = 1),  # Deixa os eixos X e Y bem visíveis
    panel.grid = element_blank(),  # Remove as linhas de grade do fundo
    legend.title = element_blank()  # Remove título da legenda
  ) +
  expand_limits(y = 0)  # Garante que o valor 0 esteja no eixo Y



