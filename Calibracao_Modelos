################################# Atmometro 1 #################################

mod_amm1=lm(eto_pm ~ ev_amm1)
summary(mod_amm1) 
b_amm1 = 1.97070 
a_amm1 = 0.31284 
r2_amm1 = 0.6368

eto_amm1=b_amm1+a_amm1*ev_amm1; list(eto_amm1)
eto_amm1=round(eto_amm1,2); eto_amm1 #modelo p/ amm1 (ETo-PM vs EV-AMM1)

## Indicadores de desemoenho

rmse_amm1 <- sqrt(mean((eto_pm - eto_amm1)^2)); rmse_amm1 #RMSE = 0.6867002
mbe_amm1=mean(eto_amm1-eto_pm); mbe_amm1 #MBE = -0.0004761905
numerador_amm1 <- sum((eto_pm - eto_amm1)^2)
denominador_amm1 <- sum((abs(eto_amm1 - mean(eto_pm)) + abs(eto_pm - mean(eto_pm)))^2)
d_amm1 <- 1 - (numerador_amm1 / denominador_amm1); d_amm1 # d = 0.8840657
sd_amm1=sd(eto_amm1); sd_amm1

## Gráfico com a linha de regressão

ggplot(dados_fase1, aes(x = ev_amm1, y = eto_pm)) +
  geom_point(color = "black", size = 4, shape = 17) +
  geom_smooth(method = "lm", color = "black", se = FALSE) +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray40", size = 1) +
  labs(x = "EV-AMM1 (mm dia⁻¹)", 
       y = "ETo-PM (mm dia⁻¹)") +
  xlim(2, 16) + ylim(2, 16) +
  theme_minimal() +
  annotate("text", x = 2.2, y = 15.5,  # posição segura dentro dos limites
           label = paste0("y = ", round(b_amm1, 2), 
                          " + ", round(a_amm1, 2), "x\nR² = ", round(r2_amm1, 2)),
           size = 6, color = "black", hjust = 0, vjust = 1) +
  theme(
    text = element_text(family = "Arial", size = 20),
    panel.grid = element_blank(),
    panel.border = element_blank(),
    axis.line = element_line(color = "black"),
    axis.text = element_text(size = 16),
    axis.title.x = element_text(face = "bold"), 
    axis.title.y = element_text(face = "bold")
  )


## Estimativa de erro

sd_amm1=sd(eto_amm1); sd_amm1
edt_amm1=eto_pm-eto_amm1; edt_amm1
edt_perc_amm1=(abs((eto_amm1-eto_pm)/eto_pm))*100; edt_perc_amm1 #percentagem de erro


plot(tm, edt_perc_amm1)
plot(ur, edt_perc_amm1)
plot(rs, edt_perc_amm1)
plot(eto_pm, edt_perc_amm1)


